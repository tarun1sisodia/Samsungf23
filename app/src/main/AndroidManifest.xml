<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Parallax degrades gracefully to a static cat on devices without a gyro. -->
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />

    <!--
      No permissions. TYPE_GAME_ROTATION_VECTOR needs none; ACTION_USER_PRESENT is
      caught with a context-registered receiver; the widget and QS tile are plain
      framework components. Force Stop / swipe-away therefore kills everything —
      which is exactly the "hard stop" the PRD asks for.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CatWallpaperService"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_info" />
        </service>

        <receiver
            android:name=".widget.CatToggleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cat_widget_info" />
        </receiver>

        <service
            android:name=".tile.CatTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_cat"
            android:label="@string/widget_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
